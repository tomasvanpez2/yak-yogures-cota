# ============================================================
#  YAK Yogurt — Plantilla de variables para Vercel
# ============================================================
#  Copia cada línea a: Vercel → Settings → Environment Variables
#  (Añade una por una con el MISMO nombre exacto).
#  ⚠️ Este archivo va SIN valores reales (gitignore lo protege).
#  Los valores reales los pegas TÚ dentro de Vercel.
#  Para desarrollo local: usa .env.local (no se sube a git).
# ============================================================

# ─────────────────────────────────────────────────────────────
#  🔐 AUTENTICACIÓN 2FA ADMIN (IMPRESCINDIBLE para /admin-private-panel)
# ─────────────────────────────────────────────────────────────
# Genera con: node -e "const {generateSecret}=require('otplib/functional'); console.log(generateSecret())"
ADMIN_TOTP_SECRET=

# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

# ─────────────────────────────────────────────────────────────
#  📱 TELEGRAM (para notificaciones de pedidos y resúmenes)
# ─────────────────────────────────────────────────────────────
# 1) Crea bot en @BotFather → /newbot → copia token
TELEGRAM_BOT_TOKEN=

# 2) Tu chat ID: habla con @userinfobot o @RawDataBot → copia número
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
#  💳 PAGOS Y WHATSAPP (públicos - empiezan con NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────
# Llave Bre-B donde paga el cliente (visible en checkout)
NEXT_PUBLIC_PAYMENT_ACCOUNT=3006539429

# Número del negocio para botón WhatsApp (footer, confirmaciones)
NEXT_PUBLIC_WHATSAPP_NUMBER=3006539429

# ─────────────────────────────────────────────────────────────
#  ⏰ CRON / SEGURIDAD
# ─────────────────────────────────────────────────────────────
# Secreto para proteger /api/cron/daily-summary (cualquier string largo)
# Genera con: node -e "console.log('yak-cron-' + require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
#  💾 STORAGE (Vercel los rellena auto al conectar Storage)
# ─────────────────────────────────────────────────────────────
# Vercel Blob (archivos/imágenes)
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Vercel KV (base de datos Redis - recomendado para producción)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─────────────────────────────────────────────────────────────
#  📝 NOTAS DE USO
# ─────────────────────────────────────────────────────────────
# 1. En LOCAL: crea .env.local con los valores reales (no se sube a git)
# 2. En VERCEL: Settings → Environment Variables → Add New (marca los 3 envs)
# 3. Mínimo para que funcione TODO:
#    - ADMIN_TOTP_SECRET, JWT_SECRET, ADMIN_JWT_SECRET (2FA admin)
#    - NEXT_PUBLIC_PAYMENT_ACCOUNT, NEXT_PUBLIC_WHATSAPP_NUMBER (checkout)
# 4. Para Telegram: TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
# 5. Para producción real: conecta Vercel KV o Blob (se auto-configuran)
# ============================================================