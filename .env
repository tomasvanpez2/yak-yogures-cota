# ============================================================
#  YAK Yogurt — Plantilla de variables para Vercel
# ============================================================
#  Puedes abrir este archivo y copiar cada línea a:
#  Vercel → tu proyecto → Settings → Environment Variables
#  (Añadir una por una con el MISMO nombre exacto).
#  ⚠️ Este archivo va SIN valores (gitignore lo protege).
#  Los valores los pegas TÚ dentro de Vercel.

# ── IMPRESCINDIBLES (sin ellas NO funciona) ────────────────
# 1) Token del bot de Telegram (el NUEVO, de @BotFather).
TELEGRAM_BOT_TOKEN=

# 2) ID de tu chat con el bot (de @userinfobot o @RawDataBot). Número.
TELEGRAM_CHAT_ID=

# 3) Llave a la que paga el cliente (Bre-B). Visible en el checkout.
NEXT_PUBLIC_PAYMENT_ACCOUNT=@3006539429

# ── OPCIONALES pero recomendadas ───────────────────────────
# Número del negocio para el botón de WhatsApp del footer.
NEXT_PUBLIC_WHATSAPP_NUMBER=3006539429

# Secreto que protege el cron del resumen diario (elige cualquier texto largo).
# CRON_SECRET=

# ── Vercel KV (solo si vas a conectar Storage → KV) ────────
# Vercel las rellena solas al conectar el storage; NO las escribas a mano.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=